---
import Base from "../layouts/Base.astro";
import { site, projects } from "../data/site";
---

<Base title={site.name} description={site.tagline}>
  <main>
    <header>
      <p class="domain">benj<span>.bid</span></p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
    </header>

    <section>
      <h2>About</h2>
      {site.bio.map((p) => <p>{p}</p>)}
    </section>

    <section>
      <h2>Projects</h2>
      <ul class="projects">
        {
          projects.map((p) => (
            <li>
              <div class="row">
                <h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
                <span class="year">{p.year}</span>
              </div>
              <p>{p.description}</p>
              {p.tags && (
                <ul class="tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Elsewhere</h2>
      <ul class="links">
        {site.links.map((l) => (
          <li>
            <a href={l.href}>{l.label} ↗</a>
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <p>Going once, going twice… © {new Date().getFullYear()} {site.short}</p>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 72px 20px 48px;
  }
  header {
    margin-bottom: 64px;
  }
  .domain {
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .domain span {
    color: var(--accent);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(44px, 9vw, 72px);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }
  .tagline {
    font-family: var(--serif);
    font-style: italic;
    font-size: 24px;
    color: var(--muted);
    margin: 0;
  }
  section {
    margin-bottom: 56px;
  }
  h2 {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .projects,
  .tags,
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .projects > li {
    padding: 4px 0 24px;
  }
  .projects > li + li {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }
  .year {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .projects p {
    margin: 6px 0 10px;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    font-size: 12px;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  footer {
    margin-top: 80px;
    font-size: 13px;
    color: var(--muted);
  }
</style>
